# Copia este archivo como .env y completa los valores. Nunca subas .env al repositorio.

# URL del proyecto de Supabase (Project Settings > API)
SUPABASE_URL=

# Solo la llave publishable (sb_publishable_...) o la anon heredada.
# NUNCA la service_role ni una sb_secret_: el servidor la rechaza.
SUPABASE_KEY=

# Puerto del servidor (por defecto 3000)
PORT=
